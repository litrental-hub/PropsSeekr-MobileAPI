<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>32355e90-9d15-409a-9a52-57a80e459697</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.16" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.16" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.16">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="9.0.16">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL.NetTopologySuite" Version="9.0.4" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.0.1" />
    <PackageReference Include="AWSSDK.SimpleEmail" Version="3.7.401" />
    <PackageReference Include="AWSSDK.SecretsManager" Version="3.7.400.27" />
    <PackageReference Include="AWSSDK.ElasticLoadBalancingV2" Version="3.7.401" />
    <PackageReference Include="AWSSDK.Lambda" Version="3.7.400" />
    <PackageReference Include="Amazon.Lambda.APIGatewayEvents" Version="2.7.0" />
    <PackageReference Include="Amazon.Lambda.Core" Version="2.3.0" />
    <PackageReference Include="Amazon.Lambda.Serialization.SystemTextJson" Version="2.4.3" />
    <!-- Use AWS SDK v3 to match the API's existing SES/Lambda dependencies. -->
    <PackageReference Include="AWSSDK.S3" Version="3.7.401" />
    <PackageReference Include="OpenAI" Version="2.1.0" />
    <PackageReference Include="Pgvector" Version="0.2.0" />
  </ItemGroup>

  <!--
    Compile the established file-processor implementation in this REST host.
    Keeping these files linked (rather than copied or rewritten) ensures the
    extraction, normalization, ingestion, embedding and matching rules remain
    byte-for-byte aligned with the Lambda during the migration.
  -->
  <ItemGroup>
    <Compile Include="..\PropsSeekr-matchingapi\LIT_Rental_Lambda\propseekr-file-processor\propseekr-file-processor\Function.cs"
             Link="FileProcessor\Function.cs" />
    <Compile Include="..\PropsSeekr-matchingapi\LIT_Rental_Lambda\propseekr-file-processor\propseekr-file-processor\FileUploadService.cs"
             Link="FileProcessor\FileUploadService.cs" />
    <Compile Include="..\PropsSeekr-matchingapi\LIT_Rental_Lambda\propseekr-file-processor\propseekr-file-processor\IngestService.cs"
             Link="FileProcessor\IngestService.cs" />
    <Compile Include="..\PropsSeekr-matchingapi\LIT_Rental_Lambda\propseekr-file-processor\propseekr-file-processor\ListingFormService.cs"
             Link="FileProcessor\ListingFormService.cs" />
    <Compile Include="..\PropsSeekr-matchingapi\LIT_Rental_Lambda\propseekr-file-processor\propseekr-file-processor\MatchesApiService.cs"
             Link="FileProcessor\MatchesApiService.cs" />
    <Compile Include="..\PropsSeekr-matchingapi\LIT_Rental_Lambda\propseekr-file-processor\propseekr-file-processor\GeocodingService.cs"
             Link="FileProcessor\GeocodingService.cs" />
    <Compile Include="..\PropsSeekr-matchingapi\LIT_Rental_Lambda\propseekr-file-processor\propseekr-file-processor\PropertyListing.cs"
             Link="FileProcessor\PropertyListing.cs" />
    <Compile Include="..\PropsSeekr-matchingapi\LIT_Rental_Lambda\propseekr-file-processor\propseekr-file-processor\PropertyListingNormalizer.cs"
             Link="FileProcessor\PropertyListingNormalizer.cs" />
    <Compile Include="..\PropsSeekr-matchingapi\LIT_Rental_Lambda\propseekr-file-processor\propseekr-file-processor\Interfaces\IHandleIngest.cs"
             Link="FileProcessor\Interfaces\IHandleIngest.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="scratch\**" />
    <Compile Remove="Tests\**" />
    <EmbeddedResource Remove="scratch\**" />
    <EmbeddedResource Remove="Tests\**" />
    <Content Remove="Tests\**" />
    <None Remove="scratch\**" />
    <None Remove="Tests\**" />
  </ItemGroup>

</Project>
