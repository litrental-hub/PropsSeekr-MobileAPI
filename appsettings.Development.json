{
  "Auth": {
    "BypassRegistrationVerification": true
  },
  "BulkImports": {
    "LocalStoragePath": "local-bulk-imports",
    "MaximumUploadBytes": 10485760
  },
  "FileProcessor": {
    "LocalBulkImportDirectory": "local-bulk-imports",
    "LocalMode": "true"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
