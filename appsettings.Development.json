{
  "ApiDocumentation": {
    "Enabled": true
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173",
      "http://localhost:8081"
    ]
  },
  "Auth": {
    "BypassRegistrationVerification": true
  },
  "BulkImports": {
    "LocalStoragePath": "local-bulk-imports",
    "MaximumUploadBytes": 10485760
  },
  "FileProcessor": {
    "LocalBulkImportDirectory": "local-bulk-imports",
    "LocalMode": "true"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
