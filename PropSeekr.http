@PropSeekr_HostAddress = http://localhost:5150

### Generate a presigned text-file upload URL
POST {{PropSeekr_HostAddress}}/api/v1/file-processor/upload
Content-Type: application/json

{
  "fileName": "WhatsApp Chat.txt"
}

### Start processing after the returned S3 PUT succeeds
POST {{PropSeekr_HostAddress}}/api/v1/file-processor/pipeline
Content-Type: application/json

{
  "key": "uploads/2026-08-26/WhatsApp_Chat_123.txt"
}

### Register a new user
POST {{PropSeekr_HostAddress}}/api/v1/auth/register
Content-Type: application/json

{
  "name": "Asha Sharma",
  "mobile": "9876543210",
  "email": "asha.sharma@example.com",
  "password": "Password@123",
  "addressLine1": "42 Green Park",
  "addressLine2": "Apt 5B",
  "city": "Jaipur",
  "state": "Rajasthan",
  "pincode": "302001",
  "aadharNumber": "123456789012",
  "panCard": "ABCDE1234F",
  "gstNumber": "08ABCDE1234F1Z5",
  "reraRegistrationNumber": "RAJ-RERA-12345"
}

