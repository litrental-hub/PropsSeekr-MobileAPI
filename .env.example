# ═══════════════════════════════════════════════════════════
# PropSeekr-MobileAPI — Environment Variables
# ═══════════════════════════════════════════════════════════
# Copy this file to .env and fill in the values.
# The .env file is gitignored and should NEVER be committed.
#
# These variables can be used:
#   - By the deploy scripts (HEALTH_CHECK_URL)
#   - By Docker containers via ECS task definition
#   - By the application via ConnectionStringHelper
# ═══════════════════════════════════════════════════════════

# ─── Database (overrides appsettings.json ConnectionString) ──
DB_HOST=propseekr-db.cveo6kcqsisw.ap-south-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=PropSeekr
DB_USER=postgres
DB_PASSWORD=
DB_SSLMODE=Require

# ─── AWS ─────────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DATABASE_SECRET_NAME=dev_test

# ─── JWT ─────────────────────────────────────────────────────
JWT_KEY=ReplaceWithAProperSecretKeyOfAdequateLength
JWT_ISSUER=PropSeekrApi
JWT_AUDIENCE=PropSeekrUsers

# ─── Razorpay ────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Deployment ──────────────────────────────────────────────
# Used by deploy scripts for post-deploy health verification
HEALTH_CHECK_URL=

# ─── Application ─────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080
